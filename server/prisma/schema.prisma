datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

model User {
  id              String        @id @default(uuid())
  username        String        @unique
  email           String?       @unique
  passwordHash    String?       @map("password_hash")
  googleId        String?       @unique @map("google_id")
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  avatarUrl       String?       @map("avatar_url")
  role            Role          @default(USER)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  sessions        UserSession[]
  otpTokens       OtpToken[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_sessions")
}

model OtpToken {
  id        String    @id @default(uuid())
  email     String
  code      String    @db.VarChar(6)
  type      String    @default("VERIFY_EMAIL")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("otp_tokens")
}

model Project {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  description String?
  isActive    Boolean          @default(true)
  channels    ChannelMapping[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("projects")
}

model ChannelMapping {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  channelId String   @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, eventType])
  @@map("channel_mappings")
}

model ServiceConnection {
  id             String    @id @default(uuid())
  slug           String    @unique
  name           String
  domain         String
  apiPrefix      String    @default("/api/v1") @map("api_prefix")
  apiKey         String?   @map("api_key")
  incomingSecret String?   @map("incoming_secret")
  isActive       Boolean   @default(true) @map("is_active")
  timeoutMs      Int       @default(5000) @map("timeout_ms")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("service_connections")
}

model CronFolder {
  id               String    @id @default(uuid())
  serviceSlug      String    @map("service_slug") @db.VarChar(64)
  folderTitle      String    @unique @map("folder_title") @db.VarChar(128)
  externalFolderId Int       @map("external_folder_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  jobs             CronJob[]

  @@index([serviceSlug])
  @@map("cron_folders")
}

model CronJob {
  id                String      @id @default(uuid())
  serviceSlug       String      @map("service_slug") @db.VarChar(64)
  jobKey            String      @map("job_key") @db.VarChar(80)
  title             String      @db.VarChar(160)
  endpointPath      String      @map("endpoint_path") @db.VarChar(255)
  httpMethod        String      @default("POST") @map("http_method") @db.VarChar(16)
  targetUrl         String      @map("target_url") @db.VarChar(512)
  schedule          Json
  timeoutSeconds    Int         @default(30) @map("timeout_seconds")
  enabled           Boolean     @default(false)
  saveResponses     Boolean     @default(true) @map("save_responses")
  encryptedHeaders  String?     @map("encrypted_headers") @db.Text
  headerKeys        String[]    @default([]) @map("header_keys")
  externalJobId     Int?        @unique @map("external_job_id")
  folderId          String?     @map("folder_id")
  folder            CronFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  lastSyncedAt      DateTime?   @map("last_synced_at")
  lastTriggerAt     DateTime?   @map("last_trigger_at")
  lastTriggerStatus Int?        @map("last_trigger_status")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@unique([serviceSlug, jobKey])
  @@index([serviceSlug])
  @@map("cron_jobs")
}

model PlatformLink {
  id             String   @id @default(uuid())
  slug           String   @unique @db.VarChar(80)
  title          String   @db.VarChar(120)
  category       String   @db.VarChar(48)
  url            String   @db.VarChar(512)
  secondaryUrl   String?  @map("secondary_url") @db.VarChar(512)
  secondaryLabel String?  @map("secondary_label") @db.VarChar(60)
  description    String?  @db.VarChar(300)
  accountNote    String?  @map("account_note") @db.VarChar(255)
  environment    String   @default("ALL") @db.VarChar(24)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([category, sortOrder])
  @@map("platform_links")
}
