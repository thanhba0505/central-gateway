# ==============================================================================
# Central Gateway — Environment Configuration Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Client (Next.js) — Default Port: 5100
# ------------------------------------------------------------------------------
PORT=5100
NEXT_PUBLIC_APP_NAME="Central Gateway"
NEXT_PUBLIC_APP_VERSION=0.2.1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5101/api/v1
INTERNAL_API_URL=http://localhost:5101/api/v1
GATEWAY_SECRET_KEY=dev_gateway_secret_key_change_in_production_32chars

# ------------------------------------------------------------------------------
# Server (NestJS) — Default Port: 5101
# ------------------------------------------------------------------------------
NODE_ENV=development
SERVER_PORT=5101
CORS_ORIGINS=http://localhost:5100,http://localhost:5000,http://localhost:4100
JWT_SECRET=central-gateway-jwt-secret-key-2026-min-32-chars
SLACK_BOT_TOKEN=

# ------------------------------------------------------------------------------
# Database & Prisma Connection — PostgreSQL on Port 5432
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/central_gateway?schema=public

# ------------------------------------------------------------------------------
# PostgreSQL (Docker Compose Local Development Only)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=central_gateway
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
